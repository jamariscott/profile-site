# Normalize line endings: store text files with LF in the repo,
# check out with the platform's native endings. Stops CRLF/LF churn on Windows.
* text=auto eol=lf

# Binary files git should never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
